{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "eastus"
    },
    "environmentName": {
      "value": "m365copilot-mcp"
    },
    "containerAppName": {
      "value": "m365copilot-mcp-app"
    },
    "containerImage": {
      "value": "ghcr.io/org/m365copilot-mcp:latest"
    },
    "envVars": {
      "value": [
        {
          "name": "MCP_SERVER",
          "value": "all"
        }
      ]
    }
  }
}
